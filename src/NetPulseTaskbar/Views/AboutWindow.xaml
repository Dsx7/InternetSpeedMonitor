<Window x:Class="NetPulseTaskbar.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NetPulse"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="490"
        Height="490"
        MinWidth="460"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33475569"/>
                    <Setter Property="BorderBrush" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- App Icon & Brand Header -->
            <RowDefinition Height="*"/>    <!-- Info Content Card -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Width="50" Height="50" CornerRadius="25"
                    Background="#1E293B"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">
                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="NetPulse Taskbar" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <Border Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="10" Padding="10,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="TxtVersion" Text="Version 1.0.0 (Production Release)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
            </Border>
        </StackPanel>

        <!-- Info Card -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Description -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="High-precision, lightweight real-time network telemetry monitor docked over the Windows Taskbar."
                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                </StackPanel>

                <!-- Author -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="AUTHOR &amp; DEVELOPER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="Al Helal Mohammod Bayijid" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Repository -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="OPEN SOURCE REPOSITORY" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Margin="0,3,0,0">
                        <Hyperlink NavigateUri="https://github.com/Dsx7/InternetSpeedMonitor" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="#38BDF8" TextDecorations="None">
                            <Run Text="https://github.com/Dsx7/InternetSpeedMonitor" FontSize="12.5" FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Stack & License -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="TECH STACK &amp; LICENSE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="C# 12 • .NET 8.0 • WPF DirectX • Win32 P/Invoke • MIT License"
                               FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource SecondaryButtonStyle}" Content="🌐 View on GitHub" HorizontalAlignment="Left" Click="OnViewOnGitHubClick"/>
            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="Close" Width="95" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="NetPulseTaskbar.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NetPulse"
        Width="440"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5"/>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33475569"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header with Logo & Title -->
            <RowDefinition Height="*"/>    <!-- Info Cards -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Width="52" Height="52" CornerRadius="26" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="NetPulse Taskbar" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtVersion" Text="Version 1.0.0 (Production Release)" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Info Card -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Text="High-precision, lightweight real-time network telemetry monitor docked over the Windows Taskbar."
                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,12"/>

                <TextBlock Text="AUTHOR &amp; DEVELOPER" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Text="Al Helal Mohammod Bayijid" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,3,0,12"/>

                <TextBlock Text="OPEN SOURCE REPOSITORY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Margin="0,3,0,12">
                    <Hyperlink NavigateUri="https://github.com/Dsx7/InternetSpeedMonitor" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="#38BDF8" TextDecorations="None">
                        <Run Text="https://github.com/Dsx7/InternetSpeedMonitor" FontSize="12" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="TECH STACK &amp; RUNTIME" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Text="C# 12 • .NET 8.0 • WPF DirectX • Win32 P/Invoke • MIT License" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource SecondaryButtonStyle}" Content="🌐 View on GitHub" HorizontalAlignment="Left" Click="OnViewOnGitHubClick"/>
            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="Close" Width="90" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>

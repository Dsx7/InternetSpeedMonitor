<Window x:Class="NetPulseTaskbar.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetPulseTaskbar.Controls"
        Title="NetPulse Telemetry Dashboard"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="880"
        Height="650"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#33475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33475569"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="16,8"
                                Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Global Controls -->
            <RowDefinition Height="Auto"/> <!-- Segmented Navigation Tabs -->
            <RowDefinition Height="*"/>    <!-- View Container (Live Monitor vs Data Usage) -->
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ NetPulse" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,10,0"/>
                    <Border Background="#1E293B" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="Connected" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Real-Time Taskbar Network Telemetry &amp; Data Usage Monitor" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Quick Action Toolbar Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPauseResume" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="OnPauseResumeClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtPauseResumeIcon" Text="⏸ "/>
                        <TextBlock x:Name="TxtPauseResumeLabel" Text="Pause"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="OnResetSessionClick">
                    <TextBlock Text="↺ Reset Session"/>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="OnOpenSettingsClick">
                    <TextBlock Text="⚙ Settings"/>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}" Click="OnOpenAboutClick">
                    <TextBlock Text="ℹ About"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabBtnLive" Content="⚡ Live Telemetry" Style="{StaticResource NavTabRadio}" IsChecked="True" Checked="OnNavTabChanged"/>
                <RadioButton x:Name="TabBtnHistory" Content="📊 Data Usage &amp; History" Style="{StaticResource NavTabRadio}" Checked="OnNavTabChanged"/>
            </StackPanel>
        </Border>

        <!-- VIEW 1: LIVE MONITOR TAB -->
        <Grid x:Name="ViewLiveMonitor" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Speed Stat Cards -->
                <RowDefinition Height="*"/>    <!-- Live Chart -->
                <RowDefinition Height="Auto"/> <!-- Detailed Telemetry & Usage Snapshot -->
            </Grid.RowDefinitions>

            <!-- Speed & Metric Cards Row -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <!-- Download Speed Card -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="↓ DOWNLOAD SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="CardDownloadSpeed" Grid.Row="1" Text="0.0 MB/s" FontSize="30" FontWeight="Bold" Foreground="#00E676" Margin="0,4,0,2"/>
                        <TextBlock x:Name="CardPeakDownload" Grid.Row="2" Text="Peak: 0.0 MB/s" FontSize="11" Foreground="#94A3B8"/>
                    </Grid>
                </Border>

                <!-- Upload Speed Card -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="7,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="↑ UPLOAD SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="CardUploadSpeed" Grid.Row="1" Text="0.0 MB/s" FontSize="30" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                        <TextBlock x:Name="CardPeakUpload" Grid.Row="2" Text="Peak: 0.0 MB/s" FontSize="11" Foreground="#94A3B8"/>
                    </Grid>
                </Border>

                <!-- Latency / Ping Card -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="LATENCY / PING" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,2" VerticalAlignment="Center">
                            <TextBlock x:Name="CardPing" Text="12" FontSize="30" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text=" ms" FontSize="16" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                        </StackPanel>
                        <TextBlock x:Name="CardJitter" Grid.Row="2" Text="Jitter: ±1 ms" FontSize="11" Foreground="#94A3B8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Live Rolling Speed Chart -->
            <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,0,14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="REAL-TIME BANDWIDTH HISTORY (60s)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Download" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0"/>
                            <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Upload" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>

                    <controls:SparklineCanvas x:Name="DashboardChart"
                                              Grid.Row="1"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ShowAreaFill="True"/>
                </Grid>
            </Border>

            <!-- Bottom Details: Network Adapter & Quick Usage Snapshot -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Network Adapter Metadata -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE NETWORK ADAPTER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DetailNicName" Text="Ethernet (Intel I219-V Gigabit)" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DetailIp" Text="IP: 192.168.0.10" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="DetailGateway" Text="Gateway: 192.168.0.1" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DetailLinkSpeed" Text="Link Speed: 1.0 Gbps" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="DetailMac" Text="MAC: 00:1A:2B:3C:4D:5E" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Usage Snapshot -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="DATA USAGE SNAPSHOT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" Cursor="Hand" Content="View Full Daily Breakdown ➔" FontSize="11" FontWeight="SemiBold" Click="OnSwitchToHistoryTabClick"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Today -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Today (Daily)" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="DetailTodayUsage" Text="2.14 GB" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Month -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="This Month" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="DetailMonthUsage" Text="34.8 GB" FontSize="14" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Total -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="All-Time Total" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="DetailAllTimeUsage" Text="120.4 GB" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- VIEW 2: DATA USAGE & DAILY HISTORY TAB -->
        <Grid x:Name="ViewDataHistory" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 3 Key Cards: Today, Month, All-Time -->
                <RowDefinition Height="Auto"/> <!-- Filters & Actions Toolbar -->
                <RowDefinition Height="*"/>    <!-- Daily History Breakdown List -->
            </Grid.RowDefinitions>

            <!-- Row 0: Summary Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today Card -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="TODAY'S USAGE (DAILY)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="HistoryCardTodayTotal" Text="0.0 MB" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                        <TextBlock x:Name="HistoryCardTodayBreakdown" Text="↓ 0.0 MB  •  ↑ 0.0 MB" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Month Card -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="7,0,7,0">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH TOTAL" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="HistoryCardMonthTotal" Text="0.0 MB" FontSize="26" FontWeight="Bold" Foreground="#00E676" Margin="0,4,0,2"/>
                        <TextBlock x:Name="HistoryCardMonthBreakdown" Text="↓ 0.0 MB  •  ↑ 0.0 MB" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Total All-Time Card -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ALL-TIME ACCUMULATED" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="HistoryCardAllTimeTotal" Text="0.0 MB" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,2"/>
                        <TextBlock x:Name="HistoryCardAllTimeBreakdown" Text="↓ 0.0 MB  •  ↑ 0.0 MB" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Filter & Action Bar -->
            <Border Grid.Row="1" Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Filter Month:" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbHistoryMonthFilter" Grid.Column="1" SelectionChanged="OnHistoryMonthFilterChanged" Height="28"/>

                    <TextBlock x:Name="TxtHistoryDaysCount" Grid.Column="2" Text="Showing all recorded days" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <Button Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Content="📥 Export CSV" Click="OnExportHistoryCsvClick"/>
                </Grid>
            </Border>

            <!-- Row 2: Daily Records Breakdown Table -->
            <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}" Padding="4">
                <DataGrid x:Name="GridDailyUsage"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#0F172A"
                          Foreground="#F8FAFC"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          HeadersVisibility="Column"
                          RowHeight="36"
                          FontSize="12">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#33475569"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Date Column (e.g. 17 Nov 2026 / Today) -->
                        <DataGridTemplateColumn Header="Date" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅 " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FriendlyDateString}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DayOfWeekName, StringFormat=' ({0})'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Usage -->
                        <DataGridTemplateColumn Header="Total Usage" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotal}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Download -->
                        <DataGridTemplateColumn Header="Download" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedDownload, StringFormat='↓ {0}'}" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Upload -->
                        <DataGridTemplateColumn Header="Upload" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedUpload, StringFormat='↑ {0}'}" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Bandwidth Ratio Bar -->
                        <DataGridTemplateColumn Header="DL / UL Ratio" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" Height="10" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClipToBounds="True">
                                        <ProgressBar Value="{Binding DownloadPercentOfTotal, Mode=OneWay}"
                                                     Foreground="#00E676"
                                                     Background="#38BDF8"
                                                     BorderThickness="0"
                                                     Maximum="100"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>

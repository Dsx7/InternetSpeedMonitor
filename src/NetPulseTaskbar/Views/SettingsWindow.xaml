<Window x:Class="NetPulseTaskbar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse Settings"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="780"
        Height="640"
        MinWidth="700"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display">

    <Window.Resources>
        <!-- TabItem Theme -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="16,10"
                                Margin="0,0,4,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Common Section Group -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#33475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Accent Action Button -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle Button -->
        <Style x:Key="SubtleBtn" TargetType="Button">
            <Setter Property="Background" Value="#33475569"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Search Bar -->
            <RowDefinition Height="*"/>    <!-- Tabs Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header & Search Filter -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="⚙ NetPulse Settings" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Configure layout, telemetry engines, styling, and data caps" FontSize="12" Foreground="#64748B"/>
            </StackPanel>

            <!-- Search Filter Box -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="6" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 " Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Multi-Tab Settings Container -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- Tab 1: General & Network -->
            <TabItem Header="General &amp; Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="PanelGeneral">
                        <!-- Network Interface Selection -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="NETWORK ADAPTER BINDING" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock Text="Select a specific network card or aggregate all active connections automatically." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbAdapters" SelectionChanged="OnAdapterSelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Polling Interval & Smoothing -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="TELEMETRY SAMPLING &amp; SMOOTHING" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sampling Interval" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbPollingInterval" Grid.Column="1" SelectionChanged="OnPollingIntervalChanged">
                                        <ComboBoxItem Content="250 ms (Ultra High)"/>
                                        <ComboBoxItem Content="500 ms (Fast)"/>
                                        <ComboBoxItem Content="1000 ms (Recommended)"/>
                                        <ComboBoxItem Content="2000 ms (Low Overhead)"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkSmoothing" Content="Enable Exponential Moving Average (EMA) Smoothing" Foreground="#F8FAFC" Margin="0,4,0,6" Checked="OnSmoothingChanged" Unchecked="OnSmoothingChanged"/>
                                
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Smoothing Factor:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderSmoothing" Grid.Column="1" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1" Value="0.35" ValueChanged="OnSmoothingFactorChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSmoothingVal" Grid.Column="2" Text="0.35" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Taskbar Docking & Window Behaviors -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="POSITIONING &amp; SYSTEM BEHAVIORS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Position Mode" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbPositionMode" Grid.Column="1" SelectionChanged="OnPositionModeChanged">
                                        <ComboBoxItem Content="Dock to Taskbar"/>
                                        <ComboBoxItem Content="Free Floating (Anywhere)"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkLockPosition" Content="Lock Position (prevent accidental dragging)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnLockPositionChanged" Unchecked="OnLockPositionChanged"/>
                                <CheckBox x:Name="ChkClickThrough" Content="Click-Through Mode (Transparent to mouse clicks; hold Ctrl+Alt to interact)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged"/>
                                <CheckBox x:Name="ChkHideFullscreen" Content="Hide Automatically in Fullscreen Games &amp; Apps (QUNS detection)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnHideFullscreenChanged" Unchecked="OnHideFullscreenChanged"/>
                                <CheckBox x:Name="ChkStartWithWindows" Content="Start Automatically with Windows" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- ICMP Ping Host -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="LATENCY &amp; PING ENGINE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkEnablePing" Content="Enable Real-Time ICMP Latency &amp; Jitter Tracking" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="OnEnablePingChanged" Unchecked="OnEnablePingChanged"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ping Target Host:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtPingHost" Grid.Column="1" Text="1.1.1.1" TextChanged="OnPingHostChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Units & Formatting -->
            <TabItem Header="Units &amp; Formatting">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="PanelUnits">
                        <!-- Unit Mode Presets -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="SPEED UNIT FORMATTING" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Unit Mode Preset" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbUnitMode" Grid.Column="1" SelectionChanged="OnUnitModeChanged">
                                        <ComboBoxItem Content="Auto (Bytes/s) - B/s, KB/s, MB/s"/>
                                        <ComboBoxItem Content="Auto (Bits/s) - bps, kbps, Mbps"/>
                                        <ComboBoxItem Content="kbps - Kilobits/s"/>
                                        <ComboBoxItem Content="mbps - Megabits/s (lower)"/>
                                        <ComboBoxItem Content="Mbps - Megabits/s (standard)"/>
                                        <ComboBoxItem Content="MBPS - Megabits/s (upper)"/>
                                        <ComboBoxItem Content="MBps - Megabytes/s"/>
                                        <ComboBoxItem Content="KB/s - Kilobytes/s"/>
                                        <ComboBoxItem Content="MB/s - Megabytes/s"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Decimal Precision" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbDecimals" Grid.Column="1" SelectionChanged="OnDecimalsChanged">
                                        <ComboBoxItem Content="Auto (Adaptive 0 or 1)"/>
                                        <ComboBoxItem Content="0 Decimals (12 MB/s)"/>
                                        <ComboBoxItem Content="1 Decimal (12.4 MB/s)"/>
                                        <ComboBoxItem Content="2 Decimals (12.45 MB/s)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Prefixes & Text Formatting -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="CUSTOM LABELS &amp; PADDING" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Download Prefix:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtDlPrefix" Grid.Column="1" Text="↓ " TextChanged="OnPrefixesChanged"/>
                                    <TextBlock Grid.Column="2" Text="Upload Prefix:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox x:Name="TxtUlPrefix" Grid.Column="3" Text="↑ " TextChanged="OnPrefixesChanged"/>
                                </Grid>

                                <CheckBox x:Name="ChkHideSuffix" Content="Hide Unit Suffix (e.g. show '12.4' instead of '12.4 MB/s')" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnFormattingCheckChanged" Unchecked="OnFormattingCheckChanged"/>
                                <CheckBox x:Name="ChkCompactSpaceless" Content="Compact Spaceless Mode (e.g. '12.4Mbps' vs '12.4 Mbps')" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnFormattingCheckChanged" Unchecked="OnFormattingCheckChanged"/>
                                <CheckBox x:Name="ChkFixedWidthPadding" Content="Fixed-Width Numeric Padding (prevents text jitter on speed changes)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnFormattingCheckChanged" Unchecked="OnFormattingCheckChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Layout Arrangement -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="LAYOUT &amp; DISPLAY MODES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Orientation Arrangement" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbLayout" Grid.Column="1" SelectionChanged="OnLayoutChanged">
                                        <ComboBoxItem Content="Vertical Stacked"/>
                                        <ComboBoxItem Content="Horizontal Single-Line"/>
                                        <ComboBoxItem Content="Download Only"/>
                                        <ComboBoxItem Content="Upload Only"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Visual Display Mode" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbDisplayMode" Grid.Column="1" SelectionChanged="OnDisplayModeChanged">
                                        <ComboBoxItem Content="Full (Default)"/>
                                        <ComboBoxItem Content="Compact"/>
                                        <ComboBoxItem Content="Minimal Only-Speed"/>
                                        <ComboBoxItem Content="Desktop Widget"/>
                                        <ComboBoxItem Content="Tray Only (Hide Taskbar)"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkSwapOrder" Content="Swap Order (Upload First, Download Second)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnSwapOrderChanged" Unchecked="OnSwapOrderChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Typography & Colors -->
            <TabItem Header="Typography &amp; Colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="PanelAppearance">
                        <!-- Font Styling -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="TYPOGRAPHY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Font Family:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontFamily" Grid.Column="1" SelectionChanged="OnFontFamilyChanged"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Font Size (pt):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderFontSize" Grid.Column="1" Minimum="7" Maximum="24" Value="10.5" ValueChanged="OnFontSizeChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtFontSizeVal" Grid.Column="2" Text="10.5" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weight:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontWeight" Grid.Column="1" SelectionChanged="OnFontWeightChanged">
                                        <ComboBoxItem Content="Regular"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="SemiBold"/>
                                        <ComboBoxItem Content="Bold"/>
                                        <ComboBoxItem Content="ExtraBold"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="Style:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ComboBox x:Name="CmbFontStyle" Grid.Column="3" SelectionChanged="OnFontStyleChanged">
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Italic"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkTabularFigures" Content="Enable OpenType Tabular Figures (Uniform Digit Width)" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged"/>
                                <CheckBox x:Name="ChkTextShadow" Content="Enable High-Contrast Text Drop Shadow" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Color Customization -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="STATIC COLOR PALETTE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Download Color:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtDlColor" Grid.Column="1" Text="#00E676" TextChanged="OnColorsChanged"/>
                                    <Border x:Name="SwatchDl" Grid.Column="2" Background="#00E676" CornerRadius="4" Margin="4,2"/>

                                    <TextBlock Grid.Column="3" Text="Upload Color:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox x:Name="TxtUlColor" Grid.Column="4" Text="#38BDF8" TextChanged="OnColorsChanged"/>
                                    <Border x:Name="SwatchUl" Grid.Column="5" Background="#38BDF8" CornerRadius="4" Margin="4,2"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Color:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBgColor" Grid.Column="1" Text="#E6111827" TextChanged="OnColorsChanged"/>
                                    <Border x:Name="SwatchBg" Grid.Column="2" Background="#111827" CornerRadius="4" Margin="4,2"/>

                                    <TextBlock Grid.Column="3" Text="Border Color:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox x:Name="TxtBorderColor" Grid.Column="4" Text="#33475569" TextChanged="OnColorsChanged"/>
                                    <Border x:Name="SwatchBorder" Grid.Column="5" Background="#475569" CornerRadius="4" Margin="4,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Speed Threshold Coloring -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="DYNAMIC BANDWIDTH THRESHOLD COLORING" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkDynamicColors" Content="Override text color based on real-time speed saturation" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="OnDynamicColorsChanged" Unchecked="OnDynamicColorsChanged"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Threshold 1 (Moderate Mbps):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderThresh1" Grid.Column="1" Minimum="1" Maximum="100" Value="5" ValueChanged="OnThresh1Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThresh1Val" Grid.Column="2" Text="5 Mbps" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Threshold 2 (High Mbps):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderThresh2" Grid.Column="1" Minimum="10" Maximum="500" Value="50" ValueChanged="OnThresh2Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThresh2Val" Grid.Column="2" Text="50 Mbps" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Widget Dimension & Sparkline Options -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="CONTAINER DIMENSIONS &amp; SPARKLINE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkSparkline" Content="Show Live Mini Sparkline Behind Text" Foreground="#F8FAFC" Margin="0,0,0,8" Checked="OnSparklineChanged" Unchecked="OnSparklineChanged"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Widget Width:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderWidth" Grid.Column="1" Minimum="80" Maximum="300" Value="140" ValueChanged="OnDimensionsChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWidthVal" Grid.Column="2" Text="140px" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Corner Radius:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderCornerRadius" Grid.Column="1" Minimum="0" Maximum="16" Value="6" ValueChanged="OnCornerRadiusChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCornerRadiusVal" Grid.Column="2" Text="6px" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Data Usage & Themes -->
            <TabItem Header="Data Usage &amp; Themes">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="PanelUsageThemes">
                        <!-- Theme Presets -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="THEME PRESETS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock Text="Quickly switch between pre-designed styling profiles." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource SubtleBtn}" Content="Windows 11 Native" Margin="0,0,8,8" Click="OnThemePresetClick"/>
                                    <Button Style="{StaticResource SubtleBtn}" Content="Cyberpunk Neon" Margin="0,0,8,8" Click="OnThemePresetClick"/>
                                    <Button Style="{StaticResource SubtleBtn}" Content="Minimal Monochrome" Margin="0,0,8,8" Click="OnThemePresetClick"/>
                                    <Button Style="{StaticResource SubtleBtn}" Content="High-Contrast Pro" Margin="0,0,8,8" Click="OnThemePresetClick"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SubtleBtn}" Content="Import JSON..." Margin="0,0,8,0" Click="OnImportThemeClick"/>
                                    <Button Style="{StaticResource SubtleBtn}" Content="Export JSON..." Click="OnExportThemeClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Alerts & Caps -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="DATA CAP &amp; SOUND ALERTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Daily Data Cap Alert (GB, 0 to disable):" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtDataCap" Grid.Column="1" Text="0" TextChanged="OnDataCapChanged"/>
                                </Grid>
                                <CheckBox x:Name="ChkSoundAlerts" Content="Play sound alert when network drops or data cap is reached" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnSoundAlertsChanged" Unchecked="OnSoundAlertsChanged"/>
                                <CheckBox x:Name="ChkDisconnectNotify" Content="Notify when network disconnected or reconnected" Foreground="#F8FAFC" Margin="0,4,0,4" Checked="OnDisconnectNotifyChanged" Unchecked="OnDisconnectNotifyChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Usage History Table & CSV Export -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RECORDED DATA USAGE HISTORY" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="📥 Export CSV" Click="OnExportCsvClick"/>
                                </Grid>

                                <DataGrid x:Name="GridUsageHistory"
                                          Height="180"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="#0F172A"
                                          Foreground="#F8FAFC"
                                          BorderBrush="#33475569"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1E293B"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateKey}" Width="120"/>
                                        <DataGridTextColumn Header="Download" Binding="{Binding FormattedDownload}" Width="*"/>
                                        <DataGridTextColumn Header="Upload" Binding="{Binding FormattedUpload}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding FormattedTotal}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#33475569" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="All changes are auto-saved and applied live." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SubtleBtn}" Margin="16,0,0,0" Padding="10,4" Content="ℹ About NetPulse" Click="OnAboutClick"/>
                </StackPanel>
                <Button Style="{StaticResource AccentBtn}" HorizontalAlignment="Right" Content="Close" Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>

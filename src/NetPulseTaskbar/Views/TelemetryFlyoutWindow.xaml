<Window x:Class="NetPulseTaskbar.Views.TelemetryFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetPulseTaskbar.Controls"
        Title="NetPulse HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="340"
        Height="310"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Fluent Dark Card Container -->
        <Border Background="#F20F172A"
                BorderBrush="#3338BDF8"
                BorderThickness="1.2"
                CornerRadius="10"
                Effect="{StaticResource FlyoutShadow}"
                Padding="14,12"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Speeds -->
                    <RowDefinition Height="85"/>   <!-- Dual Chart -->
                    <RowDefinition Height="Auto"/> <!-- Adapter Info -->
                    <RowDefinition Height="Auto"/> <!-- Usage Totals -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header & Real-time Speeds -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="NETPULSE TELEMETRY"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtDownloadSpeed"
                                       Text="↓ 0.0 MB/s"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#00E676"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtUploadSpeed"
                                       Text="↑ 0.0 MB/s"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ping & Jitter Badge -->
                    <Border Grid.Column="1"
                            Background="#1E293B"
                            BorderBrush="#33475569"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PingIndicator" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPing"
                                       Text="14 ms"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtJitter"
                                       Text="±1 ms"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="10"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Rolling History Chart -->
                <Border Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,8"
                        Padding="2">
                    <Grid>
                        <controls:SparklineCanvas x:Name="FlyoutChart"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ShowAreaFill="True"/>
                        <!-- Chart Legend Overlay -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,6,0">
                            <Ellipse Width="6" Height="6" Fill="#00E676" Margin="0,0,4,0"/>
                            <TextBlock Text="DL" FontSize="8" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,4,0"/>
                            <TextBlock Text="UL" FontSize="8" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 2: Adapter Metadata -->
                <Border Grid.Row="2"
                        Background="#1E293B"
                        BorderBrush="#33475569"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NIC Name & Link Speed -->
                        <TextBlock x:Name="TxtNicName"
                                   Grid.Row="0" Grid.Column="0"
                                   Text="Wi-Fi (Intel Wi-Fi 6)"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F5F9"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtLinkSpeed"
                                   Grid.Row="0" Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Text="Link: 866 Mbps"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="10"
                                   Foreground="#94A3B8"/>

                        <!-- IP & Gateway -->
                        <TextBlock x:Name="TxtIpAddress"
                                   Grid.Row="1" Grid.Column="0"
                                   Text="IP: 192.168.1.100"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="10"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtGateway"
                                   Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Text="GW: 192.168.1.1"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="10"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Row 3: Data Usage Ledger Cards -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Session Usage -->
                    <Border Grid.Column="0"
                            Background="#1E293B"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="SESSION USAGE" FontSize="8.5" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSessionUsage" Text="45.2 MB" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Today Usage -->
                    <Border Grid.Column="1"
                            Background="#1E293B"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="TODAY TOTAL" FontSize="8.5" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtTodayUsage" Text="1.42 GB" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
